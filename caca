-- ============================================================
--  UTILITY
-- ============================================================
local function Tween(obj, props, t)
    TweenService:Create(obj, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad), props):Play()
end

local function MakeInstance(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do inst[k] = v end
    if parent then inst.Parent = parent end
    return inst
end

local function MakePadding(parent, top, bottom, left, right)
    local p = Instance.new("UIPadding")
    p.PaddingTop    = UDim.new(0, top    or 0)
    p.PaddingBottom = UDim.new(0, bottom or 0)
    p.PaddingLeft   = UDim.new(0, left   or 0)
    p.PaddingRight  = UDim.new(0, right  or 0)
    p.Parent = parent
    return p
end

-- ============================================================
--  DRAG
-- ============================================================
local function MakeDraggable(frame, handle)
    local dragging, dragStart, startPos = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = input.Position
            startPos  = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

-- ============================================================
--  WINDOW
-- ============================================================
function FeralLib:CreateWindow(config)
    config = config or {}
    local title    = config.Title    or "FeralLib"
    local gameName = config.Game     or ""
    local width    = config.Width    or 560
    local height   = config.Height   or 420
    local sidebarW = 140

    -- ScreenGui
    local ScreenGui = MakeInstance("ScreenGui", {
        Name            = "FeralLib_" .. title,
        ResetOnSpawn    = false,
        ZIndexBehavior  = Enum.ZIndexBehavior.Sibling,
    }, (RunService:IsStudio() and LocalPlayer:WaitForChild("PlayerGui") or game:GetService("CoreGui")))

    -- Main frame
    local Main = MakeInstance("Frame", {
        Name            = "Main",
        Size            = UDim2.new(0, width, 0, height),
        Position        = UDim2.new(0.5, -width/2, 0.5, -height/2),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, ScreenGui)

    -- Outer border stroke
    MakeInstance("UIStroke", { Color = Theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, Main)

    -- ── TITLEBAR ──────────────────────────────────────────
    local Titlebar = MakeInstance("Frame", {
        Name             = "Titlebar",
        Size             = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.Titlebar,
        BorderSizePixel  = 0,
    }, Main)
    MakeInstance("UIStroke", { Color = Theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, Titlebar)
    MakeDraggable(Main, Titlebar)

    -- Avatar circle
    local Avatar = MakeInstance("Frame", {
        Size             = UDim2.new(0, 22, 0, 22),
        Position         = UDim2.new(0, 10, 0.5, -11),
        BackgroundColor3 = Theme.CheckboxOff,
        BorderSizePixel  = 0,
    }, Titlebar)
    MakeInstance("TextLabel", {
        Size             = UDim2.new(1,0,1,0),
        BackgroundTransparency = 1,
        Text             = string.sub(title, 1, 1),
        TextColor3       = Color3.fromRGB(200,200,200),
        TextSize         = 11,
        Font             = Enum.Font.GothamBold,
    }, Avatar)

    -- Title text
    MakeInstance("TextLabel", {
        Size             = UDim2.new(1, -80, 1, 0),
        Position         = UDim2.new(0, 40, 0, 0),
        BackgroundTransparency = 1,
        Text             = title,
        TextColor3       = Theme.TextTitle,
        TextSize         = 13,
        Font             = Enum.Font.GothamMedium,
        TextXAlignment   = Enum.TextXAlignment.Left,
    }, Titlebar)

    -- Close button
    local CloseBtn = MakeInstance("TextButton", {
        Size             = UDim2.new(0, 28, 0, 28),
        Position         = UDim2.new(1, -32, 0.5, -14),
        BackgroundTransparency = 1,
        Text             = "✕",
        TextColor3       = Theme.NavInactive,
        TextSize         = 13,
        Font             = Enum.Font.GothamMedium,
        BorderSizePixel  = 0,
    }, Titlebar)
    CloseBtn.MouseEnter:Connect(function() CloseBtn.TextColor3 = Color3.fromRGB(220,80,80) end)
    CloseBtn.MouseLeave:Connect(function() CloseBtn.TextColor3 = Theme.NavInactive end)
    CloseBtn.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

    -- Minimize button
    local MinBtn = MakeInstance("TextButton", {
        Size             = UDim2.new(0, 28, 0, 28),
        Position         = UDim2.new(1, -60, 0.5, -14),
        BackgroundTransparency = 1,
        Text             = "─",
        TextColor3       = Theme.NavInactive,
        TextSize         = 13,
        Font             = Enum.Font.GothamMedium,
        BorderSizePixel  = 0,
    }, Titlebar)
    local minimized = false
    local ContentHolder -- forward ref
    MinBtn.MouseEnter:Connect(function() MinBtn.TextColor3 = Color3.fromRGB(220,220,80) end)
    MinBtn.MouseLeave:Connect(function() MinBtn.TextColor3 = Theme.NavInactive end)
    MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        Tween(Main, { Size = minimized and UDim2.new(0, width, 0, 36) or UDim2.new(0, width, 0, height) }, 0.2)
    end)

    -- ── BODY ──────────────────────────────────────────────
    local Body = MakeInstance("Frame", {
        Name             = "Body",
        Size             = UDim2.new(1, 0, 1, -36),
        Position         = UDim2.new(0, 0, 0, 36),
        BackgroundTransparency = 1,
        BorderSizePixel  = 0,
        ClipsDescendants = true,
    }, Main)

    -- ── SIDEBAR ───────────────────────────────────────────
    local Sidebar = MakeInstance("Frame", {
        Name             = "Sidebar",
        Size             = UDim2.new(0, sidebarW, 1, 0),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel  = 0,
    }, Body)
    MakeInstance("UIStroke", { Color = Theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, Sidebar)

    -- Game label
    local GameLabel = MakeInstance("TextLabel", {
        Size             = UDim2.new(1, -28, 0, 30),
        Position         = UDim2.new(0, 14, 0, 6),
        BackgroundTransparency = 1,
        Text             = gameName:upper(),
        TextColor3       = Theme.SectionLabel,
        TextSize         = 10,
        Font             = Enum.Font.GothamBold,
        TextXAlignment   = Enum.TextXAlignment.Left,
    }, Sidebar)

    local NavList = MakeInstance("Frame", {
        Name             = "NavList",
        Size             = UDim2.new(1, 0, 1, -36),
        Position         = UDim2.new(0, 0, 0, 36),
        BackgroundTransparency = 1,
        BorderSizePixel  = 0,
    }, Sidebar)
    MakeInstance("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,0) }, NavList)

    -- ── CONTENT AREA ──────────────────────────────────────
    ContentHolder = MakeInstance("Frame", {
        Name             = "ContentHolder",
        Size             = UDim2.new(1, -sidebarW, 1, 0),
        Position         = UDim2.new(0, sidebarW, 0, 0),
        BackgroundColor3 = Theme.Content,
        BorderSizePixel  = 0,
        ClipsDescendants = true,
    }, Body)

    -- ── WINDOW OBJECT ─────────────────────────────────────
    local Window = { _tabs = {}, _navItems = {}, _activeTab = nil }

    local function setActiveTab(tab, navBtn, indicator)
        -- hide all tabs
        for _, t in pairs(Window._tabs) do
            t.Frame.Visible = false
        end
        -- reset all nav items
        for _, item in pairs(Window._navItems) do
            item.btn.TextColor3    = Theme.NavInactive
            item.indicator.Visible = false
        end
        -- show selected
        tab.Frame.Visible       = true
        navBtn.TextColor3       = Theme.NavActive
        indicator.Visible       = true
        Window._activeTab       = tab
    end

    function Window:CreateTab(name)
        -- Nav button
        local NavBtn = MakeInstance("TextButton", {
            Size             = UDim2.new(1, 0, 0, 32),
            BackgroundTransparency = 1,
            Text             = name,
            TextColor3       = Theme.NavInactive,
            TextSize         = 12,
            Font             = Enum.Font.GothamMedium,
            TextXAlignment   = Enum.TextXAlignment.Left,
            BorderSizePixel  = 0,
            LayoutOrder      = #self._tabs + 1,
        }, NavList)
        MakePadding(NavBtn, 0, 0, 14, 0)

        -- Active indicator bar
        local Indicator = MakeInstance("Frame", {
            Size             = UDim2.new(0, 2, 1, 0),
            Position         = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = Theme.NavIndicator,
            BorderSizePixel  = 0,
            Visible          = false,
        }, NavBtn)

        -- Hover effect
        NavBtn.MouseEnter:Connect(function()
            if NavBtn.TextColor3 ~= Theme.NavActive then
                Tween(NavBtn, { TextColor3 = Color3.fromRGB(187,187,187) }, 0.1)
            end
        end)
        NavBtn.MouseLeave:Connect(function()
            if NavBtn.TextColor3 ~= Theme.NavActive then
                Tween(NavBtn, { TextColor3 = Theme.NavInactive }, 0.1)
            end
        end)

        -- Content frame for this tab
        local TabFrame = MakeInstance("ScrollingFrame", {
            Name                  = "Tab_" .. name,
            Size                  = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel       = 0,
            ScrollBarThickness    = 2,
            ScrollBarImageColor3  = Color3.fromRGB(80,80,80),
            CanvasSize            = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize   = Enum.AutomaticSize.Y,
            Visible               = false,
        }, ContentHolder)
        MakePadding(TabFrame, 14, 14, 14, 14)
        MakeInstance("UIListLayout", {
            SortOrder  = Enum.SortOrder.LayoutOrder,
            Padding    = UDim.new(0, 8),
        }, TabFrame)

        local Tab = { Frame = TabFrame, _sections = {} }
        table.insert(self._tabs, Tab)
        table.insert(self._navItems, { btn = NavBtn, indicator = Indicator })

        NavBtn.MouseButton1Click:Connect(function()
            setActiveTab(Tab, NavBtn, Indicator)
        end)

        -- Auto-select first tab
        if #self._tabs == 1 then
            setActiveTab(Tab, NavBtn, Indicator)
        end

        -- ── SECTION ───────────────────────────────────────
        function Tab:CreateSection(sectionName)
            local SectionFrame = MakeInstance("Frame", {
                Name             = "Section_" .. sectionName,
                Size             = UDim2.new(1, 0, 0, 0),
                AutomaticSize    = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                BorderSizePixel  = 0,
                LayoutOrder      = #self._sections + 1,
            }, TabFrame)
            MakeInstance("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding   = UDim.new(0, 0),
            }, SectionFrame)

            -- Section label
            local LabelFrame = MakeInstance("Frame", {
                Size             = UDim2.new(1, 0, 0, 28),
                BackgroundTransparency = 1,
                BorderSizePixel  = 0,
                LayoutOrder      = 0,
            }, SectionFrame)
            MakeInstance("TextLabel", {
                Size             = UDim2.new(1, 0, 0, 14),
                Position         = UDim2.new(0, 0, 0, 10),
                BackgroundTransparency = 1,
                Text             = sectionName:upper(),
                TextColor3       = Theme.SectionLabel,
                TextSize         = 10,
                Font             = Enum.Font.GothamBold,
                TextXAlignment   = Enum.TextXAlignment.Left,
            }, LabelFrame)
            MakeInstance("Frame", {
                Size             = UDim2.new(1, 0, 0, 1),
                Position         = UDim2.new(0, 0, 1, -1),
                BackgroundColor3 = Theme.Divider,
                BorderSizePixel  = 0,
            }, LabelFrame)

            table.insert(self._sections, SectionFrame)
            local Section = { _frame = SectionFrame, _items = 0 }

            local function nextOrder()
                Section._items += 1
                return Section._items
            end

            local function MakeRow(h)
                local row = MakeInstance("Frame", {
                    Size             = UDim2.new(1, 0, 0, h or 44),
                    BackgroundTransparency = 1,
                    BorderSizePixel  = 0,
                    LayoutOrder      = nextOrder(),
                    ClipsDescendants = false,
                }, SectionFrame)
                -- bottom divider
                MakeInstance("Frame", {
                    Size             = UDim2.new(1, 0, 0, 1),
                    Position         = UDim2.new(0, 0, 1, -1),
                    BackgroundColor3 = Theme.Divider,
                    BorderSizePixel  = 0,
                }, row)
                return row
            end

            -- ── TOGGLE ────────────────────────────────────
            function Section:CreateToggle(config)
                config = config or {}
                local name        = config.Name        or "Toggle"
                local desc        = config.Description or ""
                local default     = config.Default     or false
                local callback    = config.Callback    or function() end

                local row = MakeRow(desc ~= "" and 48 or 36)

                -- Name
                MakeInstance("TextLabel", {
                    Size             = UDim2.new(1, -36, 0, 16),
                    Position         = UDim2.new(0, 0, 0, desc ~= "" and 8 or 10),
                    BackgroundTransparency = 1,
                    Text             = name,
                    TextColor3       = Theme.TextPrimary,
                    TextSize         = 12,
                    Font             = Enum.Font.GothamMedium,
                    TextXAlignment   = Enum.TextXAlignment.Left,
                }, row)

                -- Description
                if desc ~= "" then
                    MakeInstance("TextLabel", {
                        Size             = UDim2.new(1, -36, 0, 14),
                        Position         = UDim2.new(0, 0, 0, 26),
                        BackgroundTransparency = 1,
                        Text             = desc,
                        TextColor3       = Theme.TextSecondary,
                        TextSize         = 11,
                        Font             = Enum.Font.Gotham,
                        TextXAlignment   = Enum.TextXAlignment.Left,
                    }, row)
                end

                -- Checkbox
                local Box = MakeInstance("Frame", {
                    Size             = UDim2.new(0, 16, 0, 16),
                    Position         = UDim2.new(1, -16, 0.5, -8),
                    BackgroundColor3 = default and Theme.CheckboxOn or Theme.CheckboxOff,
                    BorderSizePixel  = 1,
                    BorderColor3     = Color3.fromRGB(80,80,80),
                }, row)

                local Tick = MakeInstance("TextLabel", {
                    Size             = UDim2.new(1,0,1,0),
                    BackgroundTransparency = 1,
                    Text             = "✓",
                    TextColor3       = Color3.fromRGB(255,255,255),
                    TextSize         = 11,
                    Font             = Enum.Font.GothamBold,
                    Visible          = default,
                }, Box)

                local state = default
                local ClickArea = MakeInstance("TextButton", {
                    Size             = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text             = "",
                    BorderSizePixel  = 0,
                }, row)
                ClickArea.MouseButton1Click:Connect(function()
                    state = not state
                    Tween(Box, { BackgroundColor3 = state and Theme.CheckboxOn or Theme.CheckboxOff }, 0.12)
                    Tick.Visible = state
                    pcall(callback, state)
                end)

                local Toggle = {}
                function Toggle:Set(v)
                    state = v
                    Tween(Box, { BackgroundColor3 = state and Theme.CheckboxOn or Theme.CheckboxOff }, 0.12)
                    Tick.Visible = state
                    pcall(callback, state)
                end
                function Toggle:Get() return state end
                return Toggle
            end

            -- ── BUTTON ────────────────────────────────────
            function Section:CreateButton(config)
                config = config or {}
                local name     = config.Name     or "Button"
                local desc     = config.Description or ""
                local callback = config.Callback  or function() end

                local row = MakeRow(desc ~= "" and 48 or 36)

                MakeInstance("TextLabel", {
                    Size             = UDim2.new(1, -80, 0, 16),
                    Position         = UDim2.new(0, 0, 0, desc ~= "" and 8 or 10),
                    BackgroundTransparency = 1,
                    Text             = name,
                    TextColor3       = Theme.TextPrimary,
                    TextSize         = 12,
                    Font             = Enum.Font.GothamMedium,
                    TextXAlignment   = Enum.TextXAlignment.Left,
                }, row)

                if desc ~= "" then
                    MakeInstance("TextLabel", {
                        Size             = UDim2.new(1, -80, 0, 14),
                        Position         = UDim2.new(0, 0, 0, 26),
                        BackgroundTransparency = 1,
                        Text             = desc,
                        TextColor3       = Theme.TextSecondary,
                        TextSize         = 11,
                        Font             = Enum.Font.Gotham,
                        TextXAlignment   = Enum.TextXAlignment.Left,
                    }, row)
                end

                local Btn = MakeInstance("TextButton", {
                    Size             = UDim2.new(0, 64, 0, 22),
                    Position         = UDim2.new(1, -64, 0.5, -11),
                    BackgroundColor3 = Theme.ButtonBg,
                    BorderSizePixel  = 1,
                    BorderColor3     = Color3.fromRGB(70,70,70),
                    Text             = "Run",
                    TextColor3       = Color3.fromRGB(200,200,200),
                    TextSize         = 11,
                    Font             = Enum.Font.GothamMedium,
                }, row)
                Btn.MouseEnter:Connect(function() Tween(Btn, { BackgroundColor3 = Theme.ButtonHover }, 0.1) end)
                Btn.MouseLeave:Connect(function() Tween(Btn, { BackgroundColor3 = Theme.ButtonBg }, 0.1) end)
                Btn.MouseButton1Click:Connect(function()
                    Tween(Btn, { BackgroundColor3 = Color3.fromRGB(70,70,70) }, 0.05)
                    task.delay(0.1, function() Tween(Btn, { BackgroundColor3 = Theme.ButtonBg }, 0.1) end)
                    pcall(callback)
                end)
            end

            -- ── DROPDOWN ──────────────────────────────────
            function Section:CreateDropdown(config)
                config = config or {}
                local name     = config.Name     or "Dropdown"
                local options  = config.Options  or {}
                local default  = config.Default  or options[1]
                local callback = config.Callback or function() end

                local row = MakeRow(36)
                row.ClipsDescendants = false
                row.ZIndex = 5

                MakeInstance("TextLabel", {
                    Size             = UDim2.new(1, -130, 1, 0),
                    Position         = UDim2.new(0, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text             = name,
                    TextColor3       = Theme.TextPrimary,
                    TextSize         = 12,
                    Font             = Enum.Font.GothamMedium,
                    TextXAlignment   = Enum.TextXAlignment.Left,
                }, row)

                local DDFrame = MakeInstance("Frame", {
                    Size             = UDim2.new(0, 120, 0, 24),
                    Position         = UDim2.new(1, -120, 0.5, -12),
                    BackgroundColor3 = Theme.InputBg,
                    BorderSizePixel  = 1,
                    BorderColor3     = Color3.fromRGB(70,70,70),
                    ZIndex           = 6,
                    ClipsDescendants = false,
                }, row)

                local Selected = MakeInstance("TextLabel", {
                    Size             = UDim2.new(1, -20, 1, 0),
                    Position         = UDim2.new(0, 6, 0, 0),
                    BackgroundTransparency = 1,
                    Text             = default or "Select...",
                    TextColor3       = Color3.fromRGB(180,180,180),
                    TextSize         = 11,
                    Font             = Enum.Font.Gotham,
                    TextXAlignment   = Enum.TextXAlignment.Left,
                    ZIndex           = 6,
                }, DDFrame)

                MakeInstance("TextLabel", {
                    Size             = UDim2.new(0, 16, 1, 0),
                    Position         = UDim2.new(1, -18, 0, 0),
                    BackgroundTransparency = 1,
                    Text             = "▾",
                    TextColor3       = Color3.fromRGB(120,120,120),
                    TextSize         = 11,
                    Font             = Enum.Font.Gotham,
                    ZIndex           = 6,
                }, DDFrame)

                -- Dropdown list (renders below)
                local ListFrame = MakeInstance("Frame", {
                    Size             = UDim2.new(1, 0, 0, #options * 24),
                    Position         = UDim2.new(0, 0, 1, 2),
                    BackgroundColor3 = Theme.DropdownBg,
                    BorderSizePixel  = 1,
                    BorderColor3     = Color3.fromRGB(70,70,70),
                    ZIndex           = 10,
                    Visible          = false,
                    ClipsDescendants = true,
                }, DDFrame)
                MakeInstance("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, ListFrame)

                for i, opt in ipairs(options) do
                    local Item = MakeInstance("TextButton", {
                        Size             = UDim2.new(1, 0, 0, 24),
                        BackgroundColor3 = Theme.DropdownItem,
                        BorderSizePixel  = 0,
                        Text             = opt,
                        TextColor3       = Color3.fromRGB(170,170,170),
                        TextSize         = 11,
                        Font             = Enum.Font.Gotham,
                        TextXAlignment   = Enum.TextXAlignment.Left,
                        ZIndex           = 10,
                        LayoutOrder      = i,
                    }, ListFrame)
                    MakePadding(Item, 0, 0, 8, 0)
                    Item.MouseEnter:Connect(function() Tween(Item, { BackgroundColor3 = Theme.DropdownHover }, 0.08) end)
                    Item.MouseLeave:Connect(function() Tween(Item, { BackgroundColor3 = Theme.DropdownItem }, 0.08) end)
                    Item.MouseButton1Click:Connect(function()
                        Selected.Text  = opt
                        ListFrame.Visible = false
                        pcall(callback, opt)
                    end)
                end

                local open = false
                local DDBtn = MakeInstance("TextButton", {
                    Size             = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text             = "",
                    ZIndex           = 7,
                    BorderSizePixel  = 0,
                }, DDFrame)
                DDBtn.MouseButton1Click:Connect(function()
                    open = not open
                    ListFrame.Visible = open
                end)

                -- Close when clicking elsewhere
                UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        if open then
                            local mp = UserInputService:GetMouseLocation()
                            local abs = ListFrame.AbsolutePosition
                            local siz = ListFrame.AbsoluteSize
                            if not (mp.X >= abs.X and mp.X <= abs.X + siz.X and
                                    mp.Y >= abs.Y and mp.Y <= abs.Y + siz.Y) then
                                open = false
                                ListFrame.Visible = false
                            end
                        end
                    end
                end)

                local Dropdown = {}
                function Dropdown:Set(v) Selected.Text = v; pcall(callback, v) end
                function Dropdown:Get() return Selected.Text end
                return Dropdown
            end

            -- ── TEXT INPUT ────────────────────────────────
            function Section:CreateTextInput(config)
                config = config or {}
                local name        = config.Name        or "Input"
                local placeholder = config.Placeholder or "Enter value..."
                local default     = config.Default     or ""
                local callback    = config.Callback    or function() end

                local row = MakeRow(36)

                MakeInstance("TextLabel", {
                    Size             = UDim2.new(1, -140, 1, 0),
                    Position         = UDim2.new(0, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text             = name,
                    TextColor3       = Theme.TextPrimary,
                    TextSize         = 12,
                    Font             = Enum.Font.GothamMedium,
                    TextXAlignment   = Enum.TextXAlignment.Left,
                }, row)

                local InputFrame = MakeInstance("Frame", {
                    Size             = UDim2.new(0, 130, 0, 24),
                    Position         = UDim2.new(1, -130, 0.5, -12),
                    BackgroundColor3 = Theme.InputBg,
                    BorderSizePixel  = 1,
                    BorderColor3     = Color3.fromRGB(70,70,70),
                }, row)

                local TextBox = MakeInstance("TextBox", {
                    Size             = UDim2.new(1, -8, 1, 0),
                    Position         = UDim2.new(0, 6, 0, 0),
                    BackgroundTransparency = 1,
                    Text             = default,
                    PlaceholderText  = placeholder,
                    PlaceholderColor3 = Color3.fromRGB(80,80,80),
                    TextColor3       = Color3.fromRGB(180,180,180),
                    TextSize         = 11,
                    Font             = Enum.Font.Gotham,
                    TextXAlignment   = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false,
                    BorderSizePixel  = 0,
                }, InputFrame)

                TextBox.Focused:Connect(function()
                    Tween(InputFrame, { BorderColor3 = Color3.fromRGB(130,130,130) }, 0.1)
                end)
                TextBox.FocusLost:Connect(function(enter)
                    Tween(InputFrame, { BorderColor3 = Color3.fromRGB(70,70,70) }, 0.1)
                    if enter then pcall(callback, TextBox.Text) end
                end)
                TextBox:GetPropertyChangedSignal("Text"):Connect(function()
                    pcall(callback, TextBox.Text)
                end)

                local Input = {}
                function Input:Set(v) TextBox.Text = v end
                function Input:Get() return TextBox.Text end
                return Input
            end

            -- ── SLIDER ────────────────────────────────────
            function Section:CreateSlider(config)
                config = config or {}
                local name     = config.Name     or "Slider"
                local min      = config.Min      or 0
                local max      = config.Max      or 100
                local default  = config.Default  or min
                local suffix   = config.Suffix   or ""
                local callback = config.Callback or function() end

                local row = MakeRow(44)
                local value = math.clamp(default, min, max)

                -- Name + value label
                local NameLabel = MakeInstance("TextLabel", {
                    Size             = UDim2.new(1, 0, 0, 14),
                    Position         = UDim2.new(0, 0, 0, 6),
                    BackgroundTransparency = 1,
                    Text             = name .. ": " .. value .. suffix,
                    TextColor3       = Theme.TextPrimary,
                    TextSize         = 12,
                    Font             = Enum.Font.GothamMedium,
                    TextXAlignment   = Enum.TextXAlignment.Left,
                }, row)

                -- Track
                local Track = MakeInstance("Frame", {
                    Size             = UDim2.new(1, 0, 0, 4),
                    Position         = UDim2.new(0, 0, 0, 28),
                    BackgroundColor3 = Color3.fromRGB(55,55,55),
                    BorderSizePixel  = 0,
                }, row)

                local Fill = MakeInstance("Frame", {
                    Size             = UDim2.new((value - min)/(max - min), 0, 1, 0),
                    BackgroundColor3 = Color3.fromRGB(150,150,150),
                    BorderSizePixel  = 0,
                }, Track)

                local Knob = MakeInstance("Frame", {
                    Size             = UDim2.new(0, 10, 0, 10),
                    Position         = UDim2.new((value - min)/(max - min), -5, 0.5, -5),
                    BackgroundColor3 = Color3.fromRGB(200,200,200),
                    BorderSizePixel  = 0,
                }, Track)

                local draggingSlider = false
                local SliderBtn = MakeInstance("TextButton", {
                    Size             = UDim2.new(1, 0, 0, 18),
                    Position         = UDim2.new(0, 0, 0, -7),
                    BackgroundTransparency = 1,
                    Text             = "",
                    BorderSizePixel  = 0,
                }, Track)

                local function updateSlider(inputX)
                    local abs  = Track.AbsolutePosition.X
                    local size = Track.AbsoluteSize.X
                    local pct  = math.clamp((inputX - abs) / size, 0, 1)
                    value = math.floor(min + pct * (max - min) + 0.5)
                    Fill.Size          = UDim2.new(pct, 0, 1, 0)
                    Knob.Position      = UDim2.new(pct, -5, 0.5, -5)
                    NameLabel.Text     = name .. ": " .. value .. suffix
                    pcall(callback, value)
                end

                SliderBtn.MouseButton1Down:Connect(function()
                    draggingSlider = true
                    updateSlider(Mouse.X)
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        draggingSlider = false
                    end
                end)
                RunService.RenderStepped:Connect(function()
                    if draggingSlider then updateSlider(Mouse.X) end
                end)

                local Slider = {}
                function Slider:Set(v)
                    value = math.clamp(v, min, max)
                    local pct = (value - min)/(max - min)
                    Fill.Size      = UDim2.new(pct, 0, 1, 0)
                    Knob.Position  = UDim2.new(pct, -5, 0.5, -5)
                    NameLabel.Text = name .. ": " .. value .. suffix
                    pcall(callback, value)
                end
                function Slider:Get() return value end
                return Slider
            end

            return Section
        end

        return Tab
    end

    -- Notify method
    function Window:Notify(config)
        config = config or {}
        local msg      = config.Message  or "Notification"
        local duration = config.Duration or 3

        local NotifGui = MakeInstance("ScreenGui", {
            Name           = "FeralNotif",
            ResetOnSpawn   = false,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        }, (RunService:IsStudio() and LocalPlayer:WaitForChild("PlayerGui") or game:GetService("CoreGui")))

        local NFrame = MakeInstance("Frame", {
            Size             = UDim2.new(0, 220, 0, 40),
            Position         = UDim2.new(1, -230, 1, -60),
            BackgroundColor3 = Color3.fromRGB(28,28,28),
            BorderSizePixel  = 1,
            BorderColor3     = Color3.fromRGB(70,70,70),
            BackgroundTransparency = 1,
        }, NotifGui)

        MakeInstance("TextLabel", {
            Size             = UDim2.new(1, -16, 1, 0),
            Position         = UDim2.new(0, 8, 0, 0),
            BackgroundTransparency = 1,
            Text             = msg,
            TextColor3       = Color3.fromRGB(190,190,190),
            TextSize         = 12,
            Font             = Enum.Font.Gotham,
            TextXAlignment   = Enum.TextXAlignment.Left,
            TextWrapped      = true,
        }, NFrame)

        Tween(NFrame, { BackgroundTransparency = 0 }, 0.2)
        task.delay(duration, function()
            Tween(NFrame, { BackgroundTransparency = 1 }, 0.3)
            task.delay(0.35, function() NotifGui:Destroy() end)
        end)
    end

    return Window
end

return FeralLib
